NODE_ENV=development
PORT=3000
# Loopback by default. Explicitly use 0.0.0.0 only for a properly secured container/server.
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=habit_tracker
DB_PASSWORD=replace_me
DB_NAME=habit_tracker
FRONTEND_URL=http://localhost:5173
# HTTPS tunnel: replace FRONTEND_URL with its exact HTTPS origin; no trailing slash.
# HTTPS automatically enables Secure session cookies, also in development.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Habit Tracker <noreply@habit-tracker.local>
# Production: HTTPS frontend, real SMTP, TLS and optional SMTP_USER/SMTP_PASSWORD.

# Optional Timer Web Push; normal app use works with these empty.
# Generate once with npm run push:keys. Never commit the real private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional HTTPS contact URI. Defaults to FRONTEND_URL, which must then be HTTPS.
# Set a stable HTTPS URI explicitly if also using local HTTP development.
VAPID_SUBJECT=
# Worker defaults to true outside NODE_ENV=test, and runs only with configured keys.
PUSH_WORKER_ENABLED=true
