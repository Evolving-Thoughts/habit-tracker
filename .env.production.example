POSTGRES_DB=habit_tracker
POSTGRES_USER=habit_tracker
POSTGRES_PASSWORD=replace_me
APP_PORT=8080

# Exact HTTPS origin of the app, no trailing slash.
FRONTEND_URL=https://habit.example.org
# Proxies in front of the backend: nginx in the web container, plus Caddy (or a tunnel)
# on the host. With too few, every client shares Caddy's address and the login limit.
TRUST_PROXY_HOPS=2

# Production needs a real SMTP service with TLS.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Habit Tracker <habit@example.org>

# Optional: Timer Web Push, see backend/.env.example.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: Google Calendar. The callback is $FRONTEND_URL/api/calendar/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_KEY=

# Focus sounds: host folder that compose.prod.yaml mounts read-only at /app/sounds
# (the backend's SOUNDS_DIR default). Upload with scripts/sounds/upload.sh.
# SOUNDS_HOST_DIR=/home/jonas/habit-sounds
