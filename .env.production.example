POSTGRES_DB=habit_tracker
POSTGRES_USER=habit_tracker
POSTGRES_PASSWORD=replace_me
APP_PORT=8080

# Exact HTTPS origin of the app, no trailing slash.
FRONTEND_URL=https://habit.example.org
# Proxies in front of the backend: 1 for nginx, plus 1 for a tunnel.
TRUST_PROXY_HOPS=1

# Production needs a real SMTP service with TLS.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Habit Tracker <habit@example.org>

# Optional: Timer Web Push, see backend/.env.example.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: Google Calendar. The callback is $FRONTEND_URL/api/calendar/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_KEY=
