{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "serve:tunnel": "node scripts/tunnel-server.mjs",
    "test:tunnel": "node --test scripts/tunnel-server.test.mjs",
    "test:push-worker": "node --test scripts/push-worker.test.mjs",
    "dev:lan": "vite --mode lan --host 0.0.0.0 --port 5174"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
