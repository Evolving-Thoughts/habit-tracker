  "components": [
    {
      "name": "Primär-Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ein orange gefüllter Haupt-Button pro Kontext, z. B. Erledigt.",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Erledigt</button>",
      "css": ".ds-btn-primary{display:inline-flex;gap:.5rem;align-items:center;justify-content:center;min-width:14rem;min-height:3.25rem;padding:0 1.5rem;border:0;border-radius:var(--radius-control,.875rem);background:var(--color-action,#c2410c);color:var(--color-on-action,#fff);font:800 1.0625rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform 420ms var(--spring,ease-out),background-color 160ms var(--ease-out,ease-out)}.ds-btn-primary:hover{background:var(--color-action-strong,#9a330a)}.ds-btn-primary:active{transform:scale(.97);transition-duration:90ms}.ds-btn-primary:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Getönter Button",
      "kind": "button",
      "refersTo": "button-tinted",
      "description": "Basis-Button (.btn): Standard für jede Nebenaktion.",
      "html": "<button class=\"ds-btn-tinted\">Verschieben</button>",
      "css": ".ds-btn-tinted{min-height:2.75rem;padding:0 1rem;border:0;border-radius:999px;background:var(--color-action-tint,#fff1e8);color:var(--color-action-strong,#9a330a);font:700 .9375rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform 420ms var(--spring,ease-out)}.ds-btn-tinted:active{transform:scale(.97);transition-duration:90ms}.ds-btn-tinted:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Leiser Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Ohne Fläche in gedämpfter Tinte, Hover Apricot-Hauch: Abbrechen, Menüeinträge.",
      "html": "<button class=\"ds-btn-quiet\">Abbrechen</button>",
      "css": ".ds-btn-quiet{min-height:2.75rem;padding:0 1rem;border:0;border-radius:999px;background:transparent;color:var(--color-ink-muted,#6b4d3d);font:700 .9375rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform 420ms var(--spring,ease-out),background-color 160ms var(--ease-out,ease-out)}.ds-btn-quiet:hover{background:var(--color-action-tint,#fff1e8);color:var(--color-action-strong,#9a330a)}.ds-btn-quiet:active{transform:scale(.97);transition-duration:90ms}.ds-btn-quiet:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Button auf Grund",
      "kind": "button",
      "refersTo": "button-on-ground",
      "description": "Weiße Pille direkt auf dem Apricot-Grund, z. B. Neu planen und Nachholen-Chips.",
      "html": "<div class=\"ds-ground\"><button class=\"ds-btn-ground\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 12a8 8 0 0 1-14 5.3M4 12a8 8 0 0 1 14-5.3\"/><path d=\"M18 3v4h-4M6 21v-4h4\"/></svg>Neu planen</button></div>",
      "css": ".ds-ground{background:var(--color-ground,#fde4d0);padding:1rem}.ds-btn-ground{display:inline-flex;gap:.5rem;align-items:center;min-height:2.75rem;padding:0 1rem 0 .75rem;border:0;border-radius:999px;background:var(--color-surface,#fff);color:var(--color-action-strong,#9a330a);font:700 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform 420ms var(--spring,ease-out)}.ds-btn-ground:active{transform:scale(.97)}.ds-btn-ground:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Timer-Icon-Button",
      "kind": "button",
      "refersTo": "icon-button-timer",
      "description": "Runder getönter Icon-Button in Tap-Größe zum Starten des Timers.",
      "html": "<button class=\"ds-timer\" aria-label=\"Timer starten\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"currentColor\" stroke=\"none\" stroke-width=\"0\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 5.5v13l10-6.5z\"/></svg></button>",
      "css": ".ds-timer{display:grid;place-items:center;width:2.75rem;height:2.75rem;padding:0;border:0;border-radius:50%;background:var(--color-action-tint,#fff1e8);color:var(--color-action-strong,#9a330a);cursor:pointer;transition:transform 160ms var(--ease-out,ease-out)}.ds-timer:active{transform:scale(.92)}.ds-timer:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:3px}"
    },
    {
      "name": "Eingabefeld",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Dialogfeld: weiß, 1.5px Apricot-Linie, weiche Ecke, oranges Caret.",
      "html": "<input class=\"ds-input\" placeholder=\"Titel\">",
      "css": ".ds-input{min-height:2.75rem;padding:0 .75rem;border:1.5px solid var(--color-line,#f1cfb4);border-radius:var(--radius-control,.875rem);background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16);caret-color:var(--color-action,#c2410c);font:400 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-input:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Segmentwahl",
      "kind": "chip",
      "refersTo": "segmented",
      "description": "Modus-Wahl wie Monat · Woche · Tag; gewählt ist Tinte auf Weiß.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Monat</button><button aria-pressed=\"false\">Woche</button><button aria-pressed=\"false\">Tag</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:.25rem;padding:.25rem;border-radius:999px;background:var(--color-ground-deep,#f9d3b5);font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-seg button{min-height:2.25rem;padding:0 1rem;border:0;border-radius:999px;background:transparent;color:var(--color-ink-muted,#6b4d3d);font:700 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer}.ds-seg button[aria-pressed=true]{background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16);box-shadow:0 1px 2px rgb(107 50 18/12%)}.ds-seg button:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Filter-Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pille mit Apricot-Linie; gewählt Weiß mit Tintenrahmen.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Alle</button><button class=\"ds-chip\" aria-pressed=\"false\">Habits</button><button class=\"ds-chip\" aria-pressed=\"false\">Todos</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:.5rem}.ds-chip{min-height:2.75rem;padding:0 1rem;border:1.5px solid var(--color-line,#f1cfb4);border-radius:999px;background:transparent;color:var(--color-ink-muted,#6b4d3d);font:700 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer}.ds-chip[aria-pressed=true]{border-color:var(--color-ink,#2b1d16);background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16)}.ds-chip:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Fokuskarte",
      "kind": "card",
      "refersTo": "card-focus",
      "description": "Die eine angehobene Karte: nächster Eintrag mit Warum, Metazeile und Erledigt.",
      "html": "<div class=\"ds-ground\"><article class=\"ds-focus\"><h2>5 km laufen</h2><p class=\"ds-focus-why\">Damit ich im März den Halbmarathon ohne Gehpause schaffe.</p><p class=\"ds-focus-meta\"><span><i style=\"background:#9a6b9e\"></i>Sport</span><span>13:30</span><span>10/35 Min.</span></p><button class=\"ds-focus-done\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Erledigt</button></article></div>",
      "css": ".ds-ground{background:var(--color-ground,#fde4d0);padding:1rem}.ds-focus{padding:1.5rem 1.5rem 1rem;border-radius:var(--radius-card,1.375rem);background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16);box-shadow:var(--shadow-card,0 1px 2px rgb(107 50 18/6%),0 6px 18px rgb(107 50 18/7%));font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-focus h2{margin:0;font-size:1.875rem;font-weight:800;line-height:1.15;letter-spacing:-.015em}.ds-focus-why{max-width:60ch;margin:.5rem 0 0;font-size:1.0625rem}.ds-focus-meta{display:flex;flex-wrap:wrap;gap:0 .75rem;margin:.75rem 0 0;color:var(--color-ink-muted,#6b4d3d);font-size:.9375rem;font-weight:700;font-variant-numeric:tabular-nums}.ds-focus-meta span{display:inline-flex;gap:.375rem;align-items:center}.ds-focus-meta i{width:.625rem;height:.625rem;border-radius:.2rem}.ds-focus-done{display:flex;gap:.5rem;align-items:center;justify-content:center;width:100%;min-height:3.25rem;margin-top:1rem;border:0;border-radius:var(--radius-control,.875rem);background:var(--color-action,#c2410c);color:var(--color-on-action,#fff);font:800 1.0625rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer;transition:transform 420ms var(--spring,ease-out),background-color 160ms var(--ease-out,ease-out)}.ds-focus-done:hover{background:var(--color-action-strong,#9a330a)}.ds-focus-done:active{transform:scale(.97)}.ds-focus-done:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Eintrag mit Haken-Ring",
      "kind": "custom",
      "refersTo": "planner-item",
      "description": "Zeit | Ring | Inhalt; der Ring füllt sich orange beim Abhaken.",
      "html": "<div class=\"ds-ground\"><div class=\"ds-item\"><span class=\"ds-item-time\">15:00</span><button class=\"ds-item-check\" aria-label=\"Erledigt\"><span></span></button><div><h3>Bewerbung überarbeiten</h3><p><i style=\"background:#8c6b55\"></i>Arbeit<b>45/60 Min.</b></p></div></div></div>",
      "css": ".ds-ground{background:var(--color-ground,#fde4d0);padding:1rem}.ds-item{display:grid;grid-template-columns:2.75rem 2.75rem minmax(0,1fr);gap:.5rem;align-items:start;padding:.5rem 1rem .75rem .75rem;border-radius:var(--radius-card,1.375rem);background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16);font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-item-time{padding-top:.7rem;color:var(--color-ink-muted,#6b4d3d);font-size:.875rem;font-weight:700;font-variant-numeric:tabular-nums}.ds-item-check{display:grid;place-items:center;width:2.75rem;height:2.75rem;padding:0;border:0;border-radius:50%;background:none;cursor:pointer;transition:transform 420ms var(--spring,ease-out)}.ds-item-check span{box-sizing:border-box;width:1.875rem;height:1.875rem;border:2.5px solid var(--color-action,#c2410c);border-radius:50%;transition:background-color 240ms var(--ease-out,ease-out)}.ds-item-check:hover span{background:var(--color-action,#c2410c)}.ds-item-check:active{transform:scale(.86);transition-duration:90ms}.ds-item-check:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}.ds-item h3{margin:.55rem 0 0;font-size:1.0625rem;font-weight:700;line-height:1.35}.ds-item p{display:flex;gap:.375rem;align-items:center;margin:.15rem 0 0;color:var(--color-ink-muted,#6b4d3d);font-size:.875rem;font-variant-numeric:tabular-nums}.ds-item b{margin-left:.375rem;font-weight:400}.ds-item i{width:.625rem;height:.625rem;border-radius:.2rem}"
    },
    {
      "name": "Quotenkarte mit Fortschrittsbalken",
      "kind": "card",
      "refersTo": "progress-bar",
      "description": "Wochenquote: große Zahl, Label, flacher Tintenbalken auf tiefem Apricot.",
      "html": "<div class=\"ds-ground\"><section class=\"ds-quota\"><p class=\"ds-quota-v\">3 von 12</p><p class=\"ds-quota-l\">Habits diese Woche</p><div class=\"ds-bar\"><span style=\"width:25%\"></span></div></section></div>",
      "css": ".ds-ground{background:var(--color-ground,#fde4d0);padding:1rem}.ds-quota{display:grid;gap:.25rem;padding:1.5rem;border-radius:var(--radius-card,1.375rem);background:var(--color-surface,#fff);color:var(--color-ink,#2b1d16);box-shadow:var(--shadow-card,0 1px 2px rgb(107 50 18/6%),0 6px 18px rgb(107 50 18/7%));font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-quota p{margin:0}.ds-quota-v{font-size:3rem;font-weight:800;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-quota-l{color:var(--color-ink-muted,#6b4d3d);font-weight:700}.ds-bar{height:.625rem;margin-top:.75rem;overflow:hidden;border-radius:999px;background:var(--color-ground-deep,#f9d3b5)}.ds-bar span{display:block;height:100%;border-radius:inherit;background:var(--color-ink,#2b1d16)}"
    },
    {
      "name": "Leerzustand",
      "kind": "card",
      "refersTo": "empty-state",
      "description": "Weiße Karte, zentriert, fetter Titel und gedämpfter Satz.",
      "html": "<div class=\"ds-ground\"><div class=\"ds-empty\"><strong>Noch nichts im Dump</strong><span>Lege oben mit Plus an, was dir durch den Kopf geht.</span></div></div>",
      "css": ".ds-ground{background:var(--color-ground,#fde4d0);padding:1rem}.ds-empty{display:grid;gap:.5rem;justify-items:center;padding:2rem 1.5rem;border-radius:var(--radius-card,1.375rem);background:var(--color-surface,#fff);color:var(--color-ink-muted,#6b4d3d);text-align:center;font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-empty strong{color:var(--color-ink,#2b1d16);font-size:1.125rem;font-weight:800}"
    },
    {
      "name": "Tab-Leiste",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Mobile Tab-Leiste: Icon über Label, aktiv orange mit kräftigerem Strich.",
      "html": "<nav class=\"ds-tabs\"><a href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4\"/></svg><span>Heute</span></a><a href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h10\"/></svg><span>Dump</span></a><a href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"3\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\"/></svg><span>Kalender</span></a></nav>",
      "css": ".ds-tabs{display:flex;padding:0 .5rem;background:var(--color-surface,#fff);box-shadow:0 -1px 0 var(--color-line,#f1cfb4),0 -8px 24px rgb(107 50 18/8%);font-family:'Nunito Variable',ui-rounded,system-ui,sans-serif}.ds-tabs a{display:flex;flex:1 1 0;flex-direction:column;gap:.2rem;align-items:center;justify-content:center;min-height:4.25rem;border-radius:var(--radius-control,.875rem);color:var(--color-ink-muted,#6b4d3d);font-size:.75rem;font-weight:700;text-decoration:none;transition:transform 420ms var(--spring,ease-out)}.ds-tabs a[aria-current=page]{color:var(--color-action,#c2410c)}.ds-tabs a:active{transform:scale(.97)}.ds-tabs a:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}"
    },
    {
      "name": "Undo-Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Ruhige Bestätigung mit Rückgängig als tintenfarbene Pille.",
      "html": "<div class=\"ds-toast\"><span>Erledigt: 5 km laufen</span><button>Rückgängig</button></div>",
      "css": ".ds-toast{display:inline-flex;gap:.75rem;align-items:center;padding:.5rem .5rem .5rem 1rem;border-radius:999px;background:var(--color-ink,#2b1d16);color:#fff;font:600 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;box-shadow:0 8px 24px rgb(43 29 22/30%);animation:ds-toast-in 240ms var(--ease-out,ease-out)}.ds-toast button{min-height:2.75rem;padding:0 1rem;border:0;border-radius:999px;background:#fff;color:var(--color-action-strong,#9a330a);font:800 1rem 'Nunito Variable',ui-rounded,system-ui,sans-serif;cursor:pointer}.ds-toast button:focus-visible{outline:3px solid var(--color-action-strong,#9a330a);outline-offset:2px}@keyframes ds-toast-in{from{transform:translateY(.75rem);opacity:0}}"
    }
  ],
  "narrative": {
    "northStar": "Der warme Küchentisch",
    "overview": "Ein Ort, an dem man morgens kurz den Tag auslegt: warmer Apricot-Grund, darauf weiße Karten mit großen weichen Ecken, eine runde, freundliche Schrift in komfortablen Größen. Das System ist ruhig und flach; Tiefe entsteht aus dem Wechsel zwischen warmem Grund und weißer Karte, nicht aus Schatten oder Verläufen.\n\nGenau eine kräftige Farbe, ein gebranntes Orange, trägt die ganze Bedienung. Sie erscheint nur auf dem, was man antippen kann: Haken, Primär-Button, aktiver Tab, Plus-Button. Alles andere spricht in warmer Tinte. Kategorien bekommen kleine, gedämpfte Farbmarken, die nie orange sind, damit Orange immer \"hier tippen\" bedeutet.\n\nBewegung ist taktil: Antippbares gibt beim Druck leicht nach und federt beim Loslassen kurz über. Liegengebliebenes und Fehler werden ohne Alarmfarbe gezeigt; die Oberfläche bietet an, statt zu mahnen.",
    "keyCharacteristics": [
      "Warmer Apricot-Grund, weiße Karten, warme braune Tinte statt Grau.",
      "Eine Aktionsfarbe, ausschließlich auf Antippbarem.",
      "Große weiche Ecken (Karte 1.375rem, Control 0.875rem, Pillen).",
      "Nunito Variable, kräftige 700/800-Gewichte für Titel und Labels, tabellarische Ziffern für Zeiten und Zählungen.",
      "Flach mit einem einzigen leisen Kartenschatten; Druck federt.",
      "Mobile zuerst: Tap-Ziele ab 2.75rem, feste Tab-Leiste unten, ab 56rem Leiste oben.",
      "Ein gemeinsamer Bausatz (Seite, Buttons, Felder, Segmentwahl, Chips, Karte, Zustände) für jede Ansicht."
    ],
    "rules": [
      {
        "name": "The Orange-Means-Tap Rule",
        "body": "Die Aktionsfarbe steht nur auf Antippbarem. Statusanzeigen, Linien, Überschriften, Fortschritt und Kategorien sind nie orange; die Jetzt-Linie ist Tinte.",
        "section": "colors"
      },
      {
        "name": "The Warm-Ink Rule",
        "body": "Es gibt kein neutrales Grau. Jeder Text- und Linienton ist ein warmes Braun aus der Tinten- oder Apricot-Familie.",
        "section": "colors"
      },
      {
        "name": "The No-Guilt Rule",
        "body": "Liegengebliebenes liegt in tiefem Apricot, nicht in Rot. Rot gehört Fehlern des Systems, nicht Versäumnissen der Person.",
        "section": "colors"
      },
      {
        "name": "The Last-Step-Red Rule",
        "body": "Neben Fehlern ist die einzige rote Fläche der letzte, unumkehrbare Schritt einer Löschung (\"Ja, löschen\"). Der Weg dorthin, etwa \"Löschen\" im Aktionsmenü, bleibt in Tinte.",
        "section": "colors"
      },
      {
        "name": "The Ink-Choice Rule",
        "body": "Auswahl ist keine zweite Farbe: gewähltes Segment und gewählter Chip sind Tinte auf Weiß, Fortschritt ist ein flacher Tintenbalken auf tiefem Apricot.",
        "section": "colors"
      },
      {
        "name": "The Tabular-Time Rule",
        "body": "Jede Uhrzeit, Minutenangabe und Zählung (\"10/35 Min.\", \"1 von 4\", \"3 von 12\") setzt tabellarische Ziffern.",
        "section": "typography"
      },
      {
        "name": "The Weight-Not-Case Rule",
        "body": "Betonung kommt über 700/800, nie über Versalien oder Sperrung. Inline-Labels wie \"Danach\" stehen fett im Satz, nicht als Überzeile.",
        "section": "typography"
      },
      {
        "name": "The One-Lifted-Card Rule",
        "body": "Pro Ansicht trägt höchstens eine ruhende Karte den Kartenschatten. Listenkarten, Leerzustände und Einstellungskarten liegen flach.",
        "section": "elevation"
      },
      {
        "name": "The Warm-Shadow Rule",
        "body": "Schatten sind weich, diffus und warmbraun getönt, nie schwarz, nie hart versetzt.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do Farben, Ecken, Abstände, Tap-Größen und Bewegung ausschließlich über die Tokens in `frontend/src/style.css` beziehen.",
      "Do neue Ansichten aus den gemeinsamen Bausteinen (Seite, Buttons, Felder, Segmentwahl, Chips, Karte, Leerzustand, Hinweis, Skelett) zusammensetzen.",
      "Do jede Nebenaktion als getönte Pille (action-tint, Schrift action-strong) bauen und pro Kontext höchstens einen orange gefüllten Primär-Button setzen.",
      "Do Zeilenaktionen in einem Menü \"Aktionen für …\" bündeln: unteres Blatt auf dem Handy, Popover ab 40rem.",
      "Do antippbare Elemente mit `--press` drücken und über `--spring` (420ms) zurückfedern lassen.",
      "Do Tap-Ziele von mindestens 2.75rem halten, auch auf dem Desktop.",
      "Do Kategorien mit `categoryMark()` als kleine Marke zeigen, nie als eingefärbte Fläche.",
      "Do Icons aus der Strichfamilie in AppIcon ergänzen (24px, Strich 2, runde Enden).",
      "Do Uhrzeiten und Zählungen mit tabellarischen Ziffern setzen."
    ],
    "donts": [
      "Don't Orange auf nicht antippbare Elemente legen (Überschriften, Linien, Status, Fortschritt, Kategorien, Verlaufspunkte).",
      "Don't Grau verwenden; Text und Linien bleiben in der warmen Tinten- und Apricot-Familie.",
      "Don't Verläufe, harte versetzte Schatten oder schwarze Schatten einsetzen.",
      "Don't Überfälliges rot färben oder als Warnblock oben stapeln; Nachholen ist ein Angebot in tiefem Apricot.",
      "Don't Rot für Löschwege vor der endgültigen Bestätigung verwenden; \"Löschen\" im Menü ist Tinte.",
      "Don't eine zweite Farbe für Auswahl einführen; gewählt heißt Tinte auf Weiß.",
      "Don't Konfetti oder Spielelemente als Bestätigung zeigen; die Bestätigung ist der gefüllte Ring und der Toast mit Rückgängig.",
      "Don't Überzeilen in Versalien über Titel setzen; Kontext steht in der Metazeile."
    ]
  }
}
